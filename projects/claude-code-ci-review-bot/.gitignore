__pycache__/
*.pyc
.pytest_cache/

# Generated metrics artifacts (regenerated by `make metrics` / `make tr3-demo`);
# the dir is kept via .gitkeep. Headline numbers live in _tasks/todo.md.
data/metrics/*.json

# Prior-findings store (written on every dedupe-enabled run — TR8/FR3); the dir
# is kept via .gitkeep. These are transient per-PR runtime artifacts, not source.
data/prior_findings/*.json

# Runtime dismissal store (mutated by `instrument --dismiss` — TR9/FR4). The
# committed demo input is fixtures/dismissed_patterns.seed.json, not this file.
data/dismissed_patterns.json
