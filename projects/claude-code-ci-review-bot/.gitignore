__pycache__/
*.pyc
.pytest_cache/

# Generated metrics artifacts (regenerated by `make metrics` / `make tr3-demo`);
# the dir is kept via .gitkeep. Headline numbers live in _tasks/todo.md.
data/metrics/*.json

# Prior-findings store (written on every dedupe-enabled run — TR8/FR3); the dir
